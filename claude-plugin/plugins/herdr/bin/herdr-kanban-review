#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=herdr-kanban-lib
source "$script_dir/herdr-kanban-lib"

kanban_require_runtime
kanban_need "$CLAUDE_BIN"

cards_json="$("$HERDR_BIN" kanban list --status reviewing)"
panes_json="$("$HERDR_BIN" pane list)"

selection_json="$(python3 - "$cards_json" "$panes_json" "$HERDR_KANBAN_MAX_REVIEWERS" <<'PY'
import json
import pathlib
import re
import sys

cards = json.loads(sys.argv[1]).get("result", {}).get("items", [])
max_reviewers = int(sys.argv[3])

# A reviewer slot is occupied by ASSIGNMENT, not by transient pane agent_status
# (same race as dispatch): a just-launched or idle-between-turns reviewer still
# holds its slot while its card sits in reviewing. Count assigned reviewers
# first, then fill the remaining capacity with unassigned cards.
active = 0
for card in cards:
    path_value = card.get("description") or ""
    if not path_value:
        continue
    path = pathlib.Path(path_value)
    if not path.is_file():
        continue
    text = path.read_text(encoding="utf-8")
    assigned = re.search(r"^assigned_pane:[ \t]*(\S+)", text, re.MULTILINE)
    owner = re.search(r"^owner_role:[ \t]*(\S+)", text, re.MULTILINE)
    if assigned and owner and owner.group(1) == "reviewer":
        active += 1

capacity = max(0, max_reviewers - active)
selected = []
for card in cards:
    if capacity <= 0:
        break
    path_value = card.get("description") or ""
    if not path_value:
        continue
    path = pathlib.Path(path_value)
    if not path.is_file():
        continue
    text = path.read_text(encoding="utf-8")
    assigned = re.search(r"^assigned_pane:[ \t]*(\S+)", text, re.MULTILINE)
    owner = re.search(r"^owner_role:[ \t]*(\S+)", text, re.MULTILINE)
    if assigned and owner and owner.group(1) == "reviewer":
        continue
    if "## Validation Evidence" not in text:
        continue
    selected.append(card)
    capacity -= 1

print(json.dumps(selected))
PY
)"

review_rows="$(python3 - "$selection_json" <<'PY'
import json
import sys

for card in json.loads(sys.argv[1]):
    print("\t".join([card["uuid"], card["title"], card.get("description") or ""]))
PY
)"

while IFS=$'\t' read -r uuid title description_path; do
  [ -n "${uuid:-}" ] || continue
  short="$(kanban_short_uuid "$uuid")"
  workspace_label="$HERDR_KANBAN_WORKSPACE_PREFIX reviewer $short"
  prompt="$(kanban_prompt_reviewer "$uuid" "$description_path")"
  claude_command="$(kanban_claude_command "$prompt" "$HERDR_KANBAN_REVIEWER_CLAUDE_MODE")"

  kanban_log "route reviewer: $uuid $title"
  if kanban_is_dry_run; then
    kanban_log "dry-run: $HERDR_BIN workspace create --cwd '$HERDR_KANBAN_WORKTREE' --label '$workspace_label' --no-focus"
    kanban_log "dry-run: HERDR_PANE_ID=<root-pane> $HERDR_BIN kanban attach $uuid"
    kanban_log "dry-run: $HERDR_BIN pane run <root-pane> '$claude_command'"
    continue
  fi

  workspace_json="$("$HERDR_BIN" workspace create --cwd "$HERDR_KANBAN_WORKTREE" --label "$workspace_label" --no-focus)"
  workspace_ids="$(python3 - "$workspace_json" <<'PY'
import json
import sys
result = json.loads(sys.argv[1])["result"]
print(result["workspace"]["workspace_id"], result["root_pane"]["pane_id"])
PY
)"
  read -r workspace_id pane_id <<<"$workspace_ids"
  HERDR_PANE_ID="$pane_id" "$HERDR_BIN" kanban attach "$uuid" >/dev/null
  kanban_update_card_meta "$description_path" "reviewer" "$pane_id" "$workspace_id" "dispatcher"
  "$HERDR_BIN" pane run "$pane_id" "$claude_command"
done <<<"$review_rows"
