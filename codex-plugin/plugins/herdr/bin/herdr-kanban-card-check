#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=herdr-kanban-lib
source "$script_dir/herdr-kanban-lib"

kanban_require_runtime

uuid="${1:-}"
if [ -z "$uuid" ]; then
  kanban_log "usage: herdr-kanban-card-check <card-uuid>"
  exit 2
fi

cards_json="$("$HERDR_BIN" kanban list)"

python3 - "$uuid" "$cards_json" <<'PY'
import json
import pathlib
import sys

uuid = sys.argv[1]
payload = json.loads(sys.argv[2])
items = payload.get("result", {}).get("items", [])
card = next((item for item in items if item.get("uuid") == uuid), None)
if card is None:
    print(f"invalid {uuid}: card not found", file=sys.stderr)
    raise SystemExit(1)

title = card.get("title", "")
path_value = card.get("description") or ""
if title.startswith("clarify:"):
    print(f"invalid {uuid}: clarify card is not routine-ready", file=sys.stderr)
    raise SystemExit(1)
if not path_value:
    print(f"invalid {uuid}: missing description path", file=sys.stderr)
    raise SystemExit(1)

path = pathlib.Path(path_value)
if not path.is_file():
    print(f"invalid {uuid}: description file not found: {path}", file=sys.stderr)
    raise SystemExit(1)

text = path.read_text(encoding="utf-8")
required_sections = [
    "## Objective",
    "## Context",
    "## Scope",
    "## Out of Scope",
    "## Acceptance",
    "## Validation",
    "## Handoff Rules",
]
missing = [section for section in required_sections if section not in text]
if missing:
    print(f"invalid {uuid}: missing sections: {', '.join(missing)}", file=sys.stderr)
    raise SystemExit(1)

print(f"ok {uuid}: {title}")
PY
